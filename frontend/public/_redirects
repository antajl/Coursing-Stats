# Static bot banners (Telegram sendPhoto) — must not fall through to SPA
/bot/* /bot/:splat 200

# BIMI logo (email inbox avatar) — must not fall through to SPA
/bimi/* /bimi/:splat 200
/.well-known/bimi/* /.well-known/bimi/:splat 200

# Never SPA-fallback CDN JSON / built assets (explicit; static files also win first)
/data/* /data/:splat 200
/assets/* /assets/:splat 200

# Client routes without a prerendered /path/index.html
# Directory index — NOT spa-shell.html (CF pretty-URL 308 to /spa-shell breaks everything)
/* /spa-shell/index.html 200
