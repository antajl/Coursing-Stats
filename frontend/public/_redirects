# Escape hatch: CF pretty-URLs turn name.html into /name and React has no such route.
# Never use a catch-all rewrite to a .html file — CF applies pretty-URL 308 to the target
# (that pattern with 404.html broke the whole site with Location /404).
/spa-shell / 301
/spa-shell/ / 301
/spa-shell.html / 301
/spa-shell/* / 301
/404 / 301
/404/ / 301
/404.html / 301

# Legacy ranking URLs still in GSC
/top /competitions?tab=ranking 301
/top-dogs /competitions?tab=ranking 301

# Static bot banners (Telegram sendPhoto)
/bot/* /bot/:splat 200

# BIMI logo
/bimi/* /bimi/:splat 200
/.well-known/bimi/* /.well-known/bimi/:splat 200

# CDN JSON / built assets (explicit; static files also win first)
/data/* /data/:splat 200
/assets/* /assets/:splat 200

# No /* catch-all: without root 404.html, CF Pages SPA mode serves /index.html
# for unknown client routes. Prerendered /dog|/event|/shows/… are real static files.
