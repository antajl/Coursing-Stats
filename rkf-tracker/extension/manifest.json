{
  "manifest_version": 3,
  "name": "CoursingStats • Заявки РКФ",
  "version": "1.1.0",
  "description": "Удобный трекер статусов заявок и мониторинг соревнований РКФ в стиле CoursingStats",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Заявки и соревнования РКФ",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "scripting",
    "tabs",
    "alarms",
    "notifications"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://rkf.online/*",
    "https://*.rkf.online/*",
    "https://coursing-stats.ru/*",
    "https://*.coursing-stats.ru/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://rkf.online/*",
        "https://*.rkf.online/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://coursing-stats.ru/*",
        "https://*.coursing-stats.ru/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["site-bridge.js"],
      "run_at": "document_start"
    }
  ]
}
