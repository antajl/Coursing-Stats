{
  "manifest_version": 3,
  "name": "CoursingStats • Заявки РКФ",
  "version": "1.0.0",
  "description": "Удобный трекер статусов заявок и титулов для личного кабинета RKF.Online в стиле CoursingStats",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Заявки РКФ",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "scripting",
    "tabs",
    "sidePanel",
    "alarms",
    "notifications"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "popup.html?mode=sidepanel"
  },
  "host_permissions": [
    "https://rkf.online/*",
    "https://*.rkf.online/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://rkf.online/*",
        "https://*.rkf.online/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
