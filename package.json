{
  "name": "coursing-stats",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "dev": "npx tsx backend/scripts/free-dev-port.ts && concurrently \"npx tsx backend/src/local-dev-server.ts\" \"cd frontend && yarn run dev\"",
    "generate-favicon": "npx tsx backend/scripts/generate-favicon.ts",
    "export-archive": "npx tsx backend/scripts/export/export-data-archive.ts",
    "export-competitions": "npx tsx backend/scripts/export/export-competitions-local.ts",
    "build-data-snapshot": "npx tsx backend/scripts/build-data-snapshot.ts",
    "build-all-data": "npx tsx backend/scripts/build-all-data.ts",
    "elo:extract": "npx tsx backend/scripts/elo/extract-races.ts",
    "elo:generate": "npx tsx backend/scripts/elo/generate-elo-index.ts",
    "elo:verify": "npx tsx backend/scripts/elo/verify-three-levels.ts",
    "elo:recalibrate": "npx tsx backend/scripts/elo/recalibrate-params.ts",
    "elo:build": "yarn run elo:extract && yarn run elo:generate && yarn run elo:verify",
    "publish-gates": "npx tsx backend/scripts/publish/verify-publish-gates.ts",
    "audit-duplicate-dogs": "npx tsx backend/scripts/audit/audit-duplicate-dogs.ts",
    "audit-duplicate-events": "npx tsx backend/scripts/audit/audit-duplicate-events.ts",
    "audit-canonical-data": "npx tsx backend/scripts/audit/validate-canonical-data.ts",
    "merge-confirmed-dogs": "npx tsx backend/scripts/audit/merge-confirmed-duplicate-dogs.ts",
    "sync-sqlite-to-v1": "npx tsx backend/scripts/sync/sync-sqlite-to-v1-cli.ts",
    "scrape-index": "npx tsx backend/scripts/scrape/scrape-year-index.ts",
    "dedupe-calendar": "npx tsx backend/scripts/migrate/dedupe-calendar-v1.ts",
    "merge-duplicate-dogs-v1": "npx tsx backend/scripts/migrate/merge-duplicate-dogs-v1.ts",
    "remove-archive-extra-ids": "npx tsx backend/scripts/migrate/remove-archive-extra-ids.ts",
    "import-archive-results": "npx tsx backend/scripts/import/import-calendar-results-from-archive.ts",
    "import-archive-results-local": "npx tsx backend/scripts/import/import-archive-results-from-local.ts",
    "download-archive-results": "npx tsx backend/scripts/import/download-archive-results.ts",
    "add-procoursing-source": "npx tsx backend/scripts/source/add-procoursing-source.ts",
    "rebuild-calendar-index": "npx tsx backend/scripts/rebuild-calendar-index.ts",
    "parse-coursing": "npx tsx backend/parsers/coursing/index.ts",
    "parse-bzmp": "npx tsx backend/parsers/bzmp/index.ts",
    "parse-racing": "npx tsx backend/parsers/racing/index.ts",
    "turso:create-schema": "npx tsx backend/scripts/create-turso-schema.ts",
    "turso:import-shows": "npx tsx backend/scripts/import-to-turso.ts",
    "turso:import-shows-cached": "npx tsx backend/scripts/import-to-turso-cached.ts",
    "turso:create-dog-links": "npx tsx backend/scripts/create-dog-links.ts",
    "shows:import-local": "npx tsx backend/scripts/import-to-local-sqlite.ts",
    "rebuild-show-year": "npx tsx backend/scripts/build-show-indexes-by-year.ts",
    "rebuild-show-snapshot": "npx --max-old-space-size=8192 tsx backend/scripts/build-show-indexes.ts",
    "generate-show-page0": "npx tsx backend/scripts/shows/generate-show-page0-indexes.ts",
    "load-events": "npx tsx backend/scripts/load/load-events.ts",
    "load-results": "npx tsx backend/scripts/load/load-results.ts",
    "reparse-bzmp": "npx tsx backend/scripts/reparse/reparse-bzmp-events.ts",
    "reparse-coursing": "npx tsx backend/scripts/reparse/reparse-coursing-events.ts",
    "reparse-racing": "npx tsx backend/scripts/reparse/reparse-racing-events.ts",
    "reparse-2023": "npx tsx backend/scripts/reparse/reparse-by-year.ts 2023",
    "reparse-2024": "npx tsx backend/scripts/reparse/reparse-by-year.ts 2024",
    "reparse-2025": "npx tsx backend/scripts/reparse/reparse-by-year.ts 2025",
    "reparse-2026": "npx tsx backend/scripts/reparse/reparse-by-year.ts 2026",
    "reparse-2026-coursing": "npx tsx backend/scripts/reparse/reparse-by-year.ts 2026 coursing",
    "reparse-2026-bzmp": "npx tsx backend/scripts/reparse/reparse-by-year.ts 2026 bzmp",
    "reparse-2026-racing": "npx tsx backend/scripts/reparse/reparse-by-year.ts 2026 racing",
    "migrate-dog-names": "npx tsx backend/scripts/migrate/migrate-normalize-dog-names.ts",
    "fix-competition-metadata": "npx tsx backend/scripts/migrate/fix-competition-metadata.ts",
    "update-current-year": "npx tsx backend/scripts/update/update-current-year.ts",
    "merge-dogs": "npx tsx backend/scripts/update/merge-dogs.ts",
    "enrich-breedarchive-urls": "npx tsx backend/scripts/enrich/enrich-breedarchive-urls.ts",
    "fetch-speed-records": "npx tsx backend/scripts/speed/fetch-speed-records.ts",
    "export-donino-speed": "npx tsx backend/scripts/speed/export-speed-from-sheets.ts",
    "export-donino-coursing": "npx tsx backend/scripts/speed/export-coursing-from-sheets.ts",
    "export-donino": "yarn run export-donino-speed && yarn run export-donino-coursing",
    "ingest-rkf-calendar": "npx tsx backend/scripts/shows/ingest-rkf-calendar.ts",
    "download-rkf-reports": "npx tsx backend/scripts/shows/download-rkf-reports.ts",
    "parse-rkf-reports": "npx tsx backend/scripts/shows/parse-rkf-reports.ts",
    "audit-pdf-wrap": "npx tsx backend/scripts/shows/audit-pdf-wrap.ts",
    "reparse-wrap-audit": "npx tsx backend/scripts/shows/reparse-wrap-audit.ts",
    "sync-local-show-protocols": "npx tsx backend/scripts/shows/sync-local-show-protocols.ts",
    "auto-process-pdf": "npx tsx backend/scripts/auto-process-pdf.ts",
    "test-parser": "npx tsx backend/scripts/test/test-parser.ts",
    "test-parser-fixtures": "npx tsx backend/scripts/test/test-parsers-fixtures.ts",
    "download-fixtures": "npx tsx backend/scripts/test/download-fixtures.ts",
    "smoke-api": "npx tsx backend/scripts/test/smoke-api.ts",
    "prerender-seo": "npx tsx backend/scripts/seo/prerender-pages.ts",
    "test": "vitest run backend/tests/",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "docs:check-links": "npx markdown-link-check docs/**/*.md --config .markdown-link-check.json",
    "docs:check-sync": "powershell -ExecutionPolicy Bypass -File scripts/check-wiki-sync.ps1",
    "security:scan": "yarn audit && grep -r \"API_KEY\\|SECRET\\|TOKEN\" --include=\"*.ts\" --include=\"*.tsx\" --exclude-dir=node_modules --exclude-dir=.next || echo \"No secrets found\"",
    "security:audit": "yarn audit && cd bot && yarn audit && cd frontend && yarn audit",
    "security:check": "yarn audit && cd bot && yarn audit && cd frontend && yarn audit",
    "security:fix": "yarn audit fix",
    "data:validate": "npx tsx backend/scripts/validate/validate-data-integrity.ts",
    "data:check": "echo \"Checking data integrity...\" && find data/v1/ -name \"*.json\" -exec node -e \"try {JSON.parse(require('fs').readFileSync('{}'))} catch(e) { console.error('Invalid JSON:', '{}'); process.exit(1)}\" \\; || echo \"Data validation complete\"",
    "data:quick": "echo \"Quick data check...\" && echo \"Data directories check - see data/v1/ for details\"",
    "perf:measure": "npx tsx backend/scripts/measure-performance.ts",
    "perf:compare": "npx tsx backend/scripts/compare-performance.ts",
    "perf:update-baseline": "npx tsx backend/scripts/measure-performance.ts && node -e \"const fs=require('fs'); const perf=require('./.devin/performance-baseline.json'); perf.timestamp=new Date().toISOString(); fs.writeFileSync('.devin/performance-baseline.json',JSON.stringify(perf,null,2))\"",
    "perf:quick": "echo \"Quick performance check...\" && echo \"Performance measurement requires detailed scripts - see .devin/skills/performance-review/SKILL.md\"",
    "quality:report": "npx tsx backend/scripts/generate-quality-report.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@sentry/cloudflare": "^10.62.0",
    "@tursodatabase/api": "^2.0.5",
    "better-sqlite3": "^12.11.1",
    "cheerio": "^1.0.0",
    "exceljs": "^4.4.0",
    "hono": "^4.12.27",
    "iconv-lite": "^0.6.3",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.12.0",
    "sql.js": "^1.14.1",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260730.1",
    "@hono/node-server": "^2.0.8",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^8.2.2",
    "dotenv": "^17.4.2",
    "miniflare": "^4.0.0",
    "sharp": "^0.35.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^2.0.0",
    "wrangler": "^4.116.0"
  },
  "overrides": {
    "jpeg-js": "^0.4.4",
    "url-regex": "^5.0.0",
    "minimist": "^1.2.8",
    "form-data": "^4.0.0",
    "qs": "^6.14.1",
    "tough-cookie": "^4.1.3",
    "uuid": "^11.1.1",
    "request": "^2.88.2",
    "@cloudflare/workers-types": "^5.20260730.1",
    "esbuild": "^0.25.0",
    "undici": "^6.28.0",
    "ws": "^8.18.0",
    "react-router": "^8.3.0"
  },
  "workspaces": [
    "frontend"
  ]
}
