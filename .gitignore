# ==========================================
# Dependencies & Package Managers
# ==========================================
node_modules/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/unplugged
.pnp.*

# ==========================================
# Environment Files & Secrets
# ==========================================
**/.env
**/.env.*
!**/.env.example
!**/.env*.example

# Bot & Cloudflare secrets
bot/.dev.vars
!bot/.dev.vars.example

# Google Search Console OAuth tokens
.gsc-tokens.json

# RKF Tracker local credentials and state
rkf-tracker/**/config.json
rkf-tracker/**/state.json
rkf-tracker/**/received.json
rkf-tracker/desktop/lib/
rkf-tracker/desktop/bin/
rkf-tracker/desktop/obj/
!rkf-tracker/**/config.example.json

# ==========================================
# Build Output & Compilers
# ==========================================
dist/
build/
frontend/dist/
frontend/.vite/
out/
*.tsbuildinfo
.wrangler/
.tmp-auth-worker/

# ==========================================
# Local SQLite & Working DB Copies
# ==========================================
**/*.sqlite
**/*.sqlite-journal
data/*.db
data/*.db-shm
data/*.db-wal
data/*.db-journal
data/v1/pc-db.sqlite.gz

# ==========================================
# Generated & Local Data Artifacts
# ==========================================
data/events/
data/exports/
data/backups/
data/backup/*
!data/backup/README.md
data/temp/
data/updates/
data/archive/snapshots/
data/archive/results/
data/tmp/
data/competitions/
data/raw-sources/
data/test-modular-parsers-results.json
data/speed-records.json
backend/data/

# Backend-only registries & import-only indices (not for CDN)
data/v1/dogs/by-key/
data/v1/dogs/registry.json
data/v1/judges/registry.json
data/v1/donino/dogs/
data/v1/indexes/sitemap-urls.json
data/v1/publish-manifest.json

# Local RKF PDF cache & temporary downloads (not for CDN / git)
data/local/
data/tmp-sample-rkf.pdf

# Shows scraper runtime files
data/v1/shows/scrape-*.log
data/v1/shows/scrape-*.json
backend/scripts/breedarchive-checkpoint.json

# Legacy ranking chunks (split by year for CDN; 01-99 chunks not needed)
data/v1/shows/indexes/dog-ranking-[0-9][0-9].json
data/v1/shows/indexes/year-data/
data/v1/shows/indexes/judge-details/judge-*.json

# Frontend public data (copied from data/v1 during build)
frontend/public/data/v1/

# ==========================================
# Test, Mock & Debug Files
# ==========================================
playwright-report/
test-results/
backend/tests/fixtures/2015/
backend/backend/
frontend/src/data/mockData.js
frontend/src/pages/Debug.tsx
backend/parsers/shows/breed-view-debug.html

# ==========================================
# Temporary Files, Dumps & Scratchpads
# ==========================================
git-files.txt
.tmp/
.tmp-seo-dialog.txt
tmp-pdf-excel-exp/
scratch/
temp_*
backend/scripts/tmp-*.ts
backend/scripts/*.py
backend/scripts/speed/fetch-speed-records-pdf.py
.tunnel-url
frontend/.tunnel-url

# Python cache & compiled bytecode
__pycache__/
*.py[cod]
*$py.class

# ==========================================
# Scripts & Batch Helpers
# ==========================================
scripts/*.bat
!scripts/update-donino.bat
!scripts/deploy-to-github.bat
!scripts/start-servers.bat

