# ==========================================
.vscode/
.idea/
*.swp
*.swo
*~
.cursor/
.windsurf/
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

